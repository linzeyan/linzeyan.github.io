&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; --prompt &lt;span style="color:#98c379"&gt;&amp;#39;哆啦Ａ夢使用竹蜻蜓飛在天空中，旁邊有大雄&amp;#39;&lt;/span&gt; &lt;span style="color:#98c379"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; --steps &lt;span style="color:#d19a66"&gt;6&lt;/span&gt; &lt;span style="color:#98c379"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; --seed &lt;span style="color:#d19a66"&gt;42&lt;/span&gt; &lt;span style="color:#98c379"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; --width &lt;span style="color:#d19a66"&gt;1240&lt;/span&gt; &lt;span style="color:#98c379"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; --height &lt;span style="color:#d19a66"&gt;1754&lt;/span&gt; &lt;span style="color:#98c379"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; --image-path pics/doramon.png &lt;span style="color:#98c379"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; --output pics/doramon1.png
