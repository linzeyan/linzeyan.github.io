&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>uv pip install mlx mlx-audio
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h4 id="convert-1">Convert&lt;/h4>
