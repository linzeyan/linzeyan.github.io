&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#c678dd"&gt;error_log&lt;/span&gt; &lt;span style="color:#98c379"&gt;error.log&lt;/span&gt; &lt;span style="color:#98c379"&gt;debug&lt;/span&gt;;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#c678dd"&gt;pid&lt;/span&gt; &lt;span style="color:#98c379"&gt;nginx.pid&lt;/span&gt;;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
