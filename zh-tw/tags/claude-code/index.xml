&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#7f848e"&gt;// 隨時檢查 Context 是否已取消&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#c678dd"&gt;select&lt;/span&gt; {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#c678dd"&gt;case&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;&amp;lt;-&lt;/span&gt;&lt;span style="color:#e06c75"&gt;ctx&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;Done&lt;/span&gt;():
