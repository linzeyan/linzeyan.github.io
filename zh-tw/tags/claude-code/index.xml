&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#7f848e"&gt;// 建立一個子 Context 用於內部的多個非同步任務&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;g&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;ctx&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;:=&lt;/span&gt; &lt;span style="color:#e06c75"&gt;errgroup&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;WithContext&lt;/span&gt;(&lt;span style="color:#e06c75"&gt;ctx&lt;/span&gt;)
