&lt;/ul&gt;
&lt;h4 id="install"&gt;Install&lt;/h4&gt;
&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-ec38af109579f8e546b716449975f64b-0"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;uv tool install git+https://github.com/Blaizzy/mlx-video.git
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"uv tool install git+https://github.com/Blaizzy/mlx-video.git\n","title":"shell"}&lt;/script&gt;&lt;/div&gt;&lt;h4 id="download-model"&gt;Download Model&lt;/h4&gt;
