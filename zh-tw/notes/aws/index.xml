&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;&amp;#34;AllowedHeaders&amp;#34;&lt;/span&gt;: [&lt;span style="color:#98c379"&gt;&amp;#34;*&amp;#34;&lt;/span&gt;],
