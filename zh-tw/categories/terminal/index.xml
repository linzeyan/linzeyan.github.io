&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#c678dd"&gt;if&lt;/span&gt; &lt;span style="color:#e06c75"&gt;configDir&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;==&lt;/span&gt; &lt;span style="color:#98c379"&gt;&amp;#34;&amp;#34;&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;||&lt;/span&gt; &lt;span style="color:#e06c75"&gt;configDir&lt;/span&gt;[&lt;span style="color:#d19a66"&gt;0&lt;/span&gt;:&lt;span style="color:#d19a66"&gt;1&lt;/span&gt;] &lt;span style="color:#56b6c2"&gt;!=&lt;/span&gt; &lt;span style="color:#98c379"&gt;&amp;#34;/&amp;#34;&lt;/span&gt; {
