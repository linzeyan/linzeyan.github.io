&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;config_dir&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;err&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;:=&lt;/span&gt; &lt;span style="color:#61afef;font-weight:bold"&gt;getConfigDir&lt;/span&gt;()
