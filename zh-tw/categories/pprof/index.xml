<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Pprof on Ricky</title><link>https://linzeyan.github.io/zh-tw/categories/pprof/</link><description>Recent content in Pprof on Ricky</description><generator>Hugo -- gohugo.io</generator><language>zh-tw</language><lastBuildDate>Wed, 22 Jun 2022 15:29:02 +0800</lastBuildDate><atom:link href="https://linzeyan.github.io/zh-tw/categories/pprof/index.xml" rel="self" type="application/rss+xml"/><item><title>golang pprof 实战</title><link>https://linzeyan.github.io/zh-tw/posts/2022/20220622-go-ppof-practice/</link><pubDate>Wed, 22 Jun 2022 15:29:02 +0800</pubDate><guid>https://linzeyan.github.io/zh-tw/posts/2022/20220622-go-ppof-practice/</guid><description>&lt;ul&gt;
&lt;li&gt;&lt;a href="https://blog.wolfogre.com/posts/go-ppof-practice/" target="_blank" rel="noopener"&gt;golang pprof 实战&lt;/a&gt;&lt;/li&gt;
