&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;FGTAWS0004BE1ADE (api-user) # edit api-admin
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;new entry &amp;#39;api-admin&amp;#39; added
