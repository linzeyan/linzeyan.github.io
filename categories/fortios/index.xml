&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-2d32b057100e117664a21cb63b538705-2"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-fallback" data-lang="fallback"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;FGTAWS0004BE1ADE # execute api-user generate-key api-admin
