&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;return&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="s"&gt;&amp;#34;&amp;#34;&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nx"&gt;err&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="p"&gt;}&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;return&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nx"&gt;filepath&lt;/span&gt;&lt;span class="p"&gt;.&lt;/span&gt;&lt;span class="nf"&gt;Join&lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="nx"&gt;homeDir&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="s"&gt;&amp;#34;.config&amp;#34;&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="s"&gt;&amp;#34;my-application-name&amp;#34;&lt;/span&gt;&lt;span class="p"&gt;),&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="kc"&gt;nil&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="p"&gt;}&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="c1"&gt;// The value of the environment variable is valid; use it&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;return&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nx"&gt;filepath&lt;/span&gt;&lt;span class="p"&gt;.&lt;/span&gt;&lt;span class="nf"&gt;Join&lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="nx"&gt;configDir&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="s"&gt;&amp;#34;my-application-name&amp;#34;&lt;/span&gt;&lt;span class="p"&gt;),&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="kc"&gt;nil&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="p"&gt;}&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="kd"&gt;func&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nf"&gt;main&lt;/span&gt;&lt;span class="p"&gt;()&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="p"&gt;{&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nx"&gt;config_dir&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nx"&gt;err&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="o"&gt;:=&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nf"&gt;getConfigDir&lt;/span&gt;&lt;span class="p"&gt;()&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;if&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nx"&gt;err&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="o"&gt;!=&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="kc"&gt;nil&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="p"&gt;{&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nb"&gt;panic&lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="nx"&gt;err&lt;/span&gt;&lt;span class="p"&gt;)&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="p"&gt;}&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="nx"&gt;fmt&lt;/span&gt;&lt;span class="p"&gt;.&lt;/span&gt;&lt;span class="nf"&gt;Println&lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="nx"&gt;config_dir&lt;/span&gt;&lt;span class="p"&gt;)&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="p"&gt;}&lt;/span&gt;&lt;span class="w"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"package main\nimport (\n \"os\"\n \"fmt\"\n \"log\"\n \"path/filepath\"\n)\n\nfunc getConfigDir() (string, error) {\n configDir := os.Getenv(\"XDG_CONFIG_HOME\")\n\n // If the value of the environment variable is unset, empty, or not an absolute path, use the default\n if configDir == \"\" || configDir[0:1] != \"/\" {\n homeDir, err := os.UserHomeDir()\n if err != nil {\n return \"\", err\n }\n return filepath.Join(homeDir, \".config\", \"my-application-name\"), nil\n }\n\n // The value of the environment variable is valid; use it\n return filepath.Join(configDir, \"my-application-name\"), nil\n}\n\nfunc main() {\n config_dir, err := getConfigDir()\n if err != nil {\n panic(err)\n }\n\n fmt.Println(config_dir)\n}\n","title":"go"}&lt;/script&gt;&lt;/div&gt;&lt;hr&gt;
&lt;h2 id="whichllm"&gt;whichllm&lt;/h2&gt;
&lt;p&gt;&lt;code&gt;uvx whichllm@latest&lt;/code&gt;&lt;/p&gt;</description></item><item><title>How Terminals Work</title><link>https://linzeyan.github.io/posts/2026/20260109-how-terminals-work/</link><pubDate>Fri, 09 Jan 2026 16:11:33 +0800</pubDate><guid>https://linzeyan.github.io/posts/2026/20260109-how-terminals-work/</guid><description>&lt;ul&gt;
&lt;li&gt;&lt;a href="https://how-terminals-work.vercel.app/" target="_blank" rel="noopener"&gt;How Terminals Work&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;</description></item><item><title>iTerm2 features I find useful</title><link>https://linzeyan.github.io/posts/2025/20250209-iterm2-features-i-find-useful/</link><pubDate>Sun, 09 Feb 2025 08:52:00 +0800</pubDate><guid>https://linzeyan.github.io/posts/2025/20250209-iterm2-features-i-find-useful/</guid><description>&lt;ul&gt;
&lt;li&gt;&lt;a href="https://danielde.dev/blog/iterm2-features-i-find-useful" target="_blank" rel="noopener"&gt;iTerm2 features I find useful&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;ol&gt;
&lt;li&gt;Show Timestamps ==&amp;gt; &lt;code&gt;⌘+Shift+E&lt;/code&gt;&lt;/li&gt;
&lt;li&gt;Alert on next prompt ==&amp;gt; &lt;code&gt;⌘+Option+A&lt;/code&gt;&lt;/li&gt;
&lt;li&gt;Jump between prompts ==&amp;gt; &lt;code&gt;⌘+Shift+Down&lt;/code&gt;&lt;/li&gt;
&lt;li&gt;Hotkeys to scroll one line at a time ==&amp;gt; &lt;code&gt;⌘+Up&lt;/code&gt; and &lt;code&gt;⌘+Down&lt;/code&gt;&lt;/li&gt;
&lt;li&gt;Rearrange tabs with hotkeys ==&amp;gt; &lt;code&gt;Ctrl+Shift+B&lt;/code&gt; and &lt;code&gt;Ctrl+Shift+F&lt;/code&gt;&lt;/li&gt;
&lt;/ol&gt;</description></item><item><title>Rules that terminal programs follow</title><link>https://linzeyan.github.io/posts/2024/20241225-terminal-rules/</link><pubDate>Wed, 25 Dec 2024 08:45:00 +0800</pubDate><guid>https://linzeyan.github.io/posts/2024/20241225-terminal-rules/</guid><description>&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;&lt;a href="https://jvns.ca/blog/2024/11/26/terminal-rules/" target="_blank" rel="noopener"&gt;&amp;ldquo;Rules&amp;rdquo; that terminal programs follow&lt;/a&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;rule 1: noninteractive programs should quit when you press Ctrl-C&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;rule 2: TUIs should quit when you press q&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;rule 3: REPLs should quit when you press Ctrl-D on an empty line&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;rule 4: don&amp;rsquo;t use more than 16 colours&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;rule 5: vaguely support readline keybindings&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;rule 5.1: Ctrl-W should delete the last word&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;rule 6: disable colours when writing to a pipe&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;rule 7: - means stdin/stdout&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;</description></item><item><title>A python script that allows your terminal to snow.</title><link>https://linzeyan.github.io/posts/2023/20231224-snow/</link><pubDate>Sun, 24 Dec 2023 15:40:00 +0800</pubDate><guid>https://linzeyan.github.io/posts/2023/20231224-snow/</guid><description>&lt;ul&gt;
&lt;li&gt;&lt;a href="https://github.com/sontek/snowmachine" target="_blank" rel="noopener"&gt;A python script that allows your terminal to snow.&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-6a6ef6b6a3a6399ed2c0a14e976808c1-0"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-bash" data-lang="bash"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;docker run --rm -ti sontek/snowmachine tree --color rainbow --particle &lt;span class="s2"&gt;&amp;#34;*&amp;#34;&lt;/span&gt; --snow &lt;span class="nb"&gt;true&lt;/span&gt; --lights-color rainbow
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"docker run --rm -ti sontek/snowmachine tree --color rainbow --particle \"*\" --snow true --lights-color rainbow\n","title":"bash"}&lt;/script&gt;&lt;/div&gt;</description></item><item><title>Use terminal and SSH to remote host</title><link>https://linzeyan.github.io/posts/2023/20231124-ssh/</link><pubDate>Fri, 24 Nov 2023 22:22:00 +0800</pubDate><guid>https://linzeyan.github.io/posts/2023/20231124-ssh/</guid><description>&lt;h1 id="use-terminal-and-ssh-to-remote-host"&gt;Use terminal and SSH to remote host&lt;/h1&gt;
&lt;h2 id="1-modern-terminals"&gt;1. Modern Terminals&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;a href="https://github.com/vercel/hyper" target="_blank" rel="noopener"&gt;Hyper&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://iterm2.com/" target="_blank" rel="noopener"&gt;iTerm2&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://github.com/Eugeny/tabby" target="_blank" rel="noopener"&gt;Tabby&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://www.warp.dev/" target="_blank" rel="noopener"&gt;Warp&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://github.com/wez/wezterm" target="_blank" rel="noopener"&gt;Wez&amp;rsquo;s Terminal&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://github.com/kingToolbox/WindTerm" target="_blank" rel="noopener"&gt;WindTerm&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2 id="2-open-terminal-in-macos"&gt;2. Open terminal in macOS&lt;/h2&gt;
&lt;ol&gt;
&lt;li&gt;&lt;code&gt;⌘ + space&lt;/code&gt; open Spotlight
&lt;img src="https://linzeyan.github.io/posts/2023/20231124-ssh/pics/auto_20231124_222253.png" alt=""&gt;&lt;/li&gt;
&lt;li&gt;search terminal.app
&lt;img src="https://linzeyan.github.io/posts/2023/20231124-ssh/pics/auto_20231124_222316.png" alt=""&gt;&lt;/li&gt;
&lt;li&gt;press &lt;code&gt;↩&lt;/code&gt;
&lt;img src="https://linzeyan.github.io/posts/2023/20231124-ssh/pics/auto_20231124_222410.png" alt=""&gt;&lt;/li&gt;
&lt;/ol&gt;
&lt;h2 id="3-ssh-to-remote-host"&gt;3. SSH to remote host&lt;/h2&gt;
&lt;ol&gt;
&lt;li&gt;ensure the private key file path.&lt;/li&gt;
&lt;li&gt;enter the command in the terminal: &lt;code&gt;ssh -i /path/to/private_key.pem ubuntu@ubuntu.host.com&lt;/code&gt;&lt;/li&gt;
&lt;/ol&gt;</description></item><item><title>Rust Easy! Modern Cross-platform Command Line Tools to Supercharge Your Terminal</title><link>https://linzeyan.github.io/posts/2023/20230113-rust-terminal-tools-linux-mac-windows-fish-zsh/</link><pubDate>Fri, 13 Jan 2023 16:51:01 +0800</pubDate><guid>https://linzeyan.github.io/posts/2023/20230113-rust-terminal-tools-linux-mac-windows-fish-zsh/</guid><description>&lt;ul&gt;
&lt;li&gt;&lt;a href="https://deepu.tech/rust-terminal-tools-linux-mac-windows-fish-zsh/" target="_blank" rel="noopener"&gt;Rust Easy! Modern Cross-platform Command Line Tools to Supercharge Your Terminal&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h4 id="alacritty"&gt;&lt;a href="https://github.com/alacritty/alacritty" target="_blank" rel="noopener"&gt;Alacritty&lt;/a&gt;&lt;/h4&gt;
&lt;p&gt;Alacritty is a cross-platform modern terminal emulator with sensible defaults. It is GPU accelerated, super fast, and highly configurable. You can use it on Linux, macOS, and Windows.&lt;/p&gt;
&lt;h4 id="bat"&gt;&lt;a href="https://github.com/sharkdp/bat" target="_blank" rel="noopener"&gt;bat&lt;/a&gt;&lt;/h4&gt;
&lt;p&gt;bat is one of my favorite tools from this list. It&amp;rsquo;s a replacement for cat.&lt;/p&gt;
&lt;h4 id="dust"&gt;&lt;a href="https://github.com/bootandy/dust" target="_blank" rel="noopener"&gt;dust&lt;/a&gt;&lt;/h4&gt;
&lt;p&gt;Dust is an alternative for the du command. It is fast and has a better UX with nice visualization for disk usage.&lt;/p&gt;</description></item><item><title>Super easy! Build a beautiful and handy zsh terminal</title><link>https://linzeyan.github.io/posts/2021/20211009-zsh/</link><pubDate>Thu, 07 Oct 2021 08:44:18 +0800</pubDate><guid>https://linzeyan.github.io/posts/2021/20211009-zsh/</guid><description>&lt;ul&gt;
&lt;li&gt;&lt;a href="https://medium.com/@white1033/%E8%B6%85%E7%B0%A1%E5%96%AE-%E5%BF%AB%E9%80%9F%E6%89%93%E9%80%A0%E6%BC%82%E4%BA%AE%E5%8F%88%E5%A5%BD%E7%94%A8%E7%9A%84-zsh-%E7%B5%82%E7%AB%AF%E7%92%B0%E5%A2%83-c81874368264" target="_blank" rel="noopener"&gt;Super easy! Build a beautiful and handy zsh terminal&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://dwye.dev/post/zsh-zim-powerlevel10k/" target="_blank" rel="noopener"&gt;Make your terminal stylish and fast with zsh + zim + powerlevel10k&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://medium.com/starbugs/%E6%89%93%E9%80%A0-10x-engineer-zsh-shell-97e40db76391" target="_blank" rel="noopener"&gt;Build a 10X Engineer shell environment&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;</description></item><item><title>Style PowerShell with oh-my-posh</title><link>https://linzeyan.github.io/posts/2020/20201210-setting-powershell-theme-with-oh-my-posh/</link><pubDate>Thu, 10 Dec 2020 13:15:59 +0800</pubDate><guid>https://linzeyan.github.io/posts/2020/20201210-setting-powershell-theme-with-oh-my-posh/</guid><description>&lt;ul&gt;
&lt;li&gt;&lt;a href="https://blog.poychang.net/setting-powershell-theme-with-oh-my-posh/" target="_blank" rel="noopener"&gt;Style PowerShell with oh-my-posh&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-e95bbfa7c1e880e2f2fd8e746abff6eb-0"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-powershell" data-lang="powershell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c"&gt;# This downloads and installs the posh-git and oh-my-posh modules from PowerShell Gallery.&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c"&gt;# The former shows Git info in the prompt, and the latter provides the themes.&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nb"&gt;Install-Module&lt;/span&gt; &lt;span class="nb"&gt;posh-git&lt;/span&gt; &lt;span class="n"&gt;-Scope&lt;/span&gt; &lt;span class="n"&gt;CurrentUser&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nb"&gt;Install-Module&lt;/span&gt; &lt;span class="nb"&gt;oh-my&lt;/span&gt;&lt;span class="n"&gt;-posh&lt;/span&gt; &lt;span class="n"&gt;-Scope&lt;/span&gt; &lt;span class="n"&gt;CurrentUser&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c"&gt;# Next, edit the PowerShell profile loaded at startup. In PowerShell, $PROFILE shows the current&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c"&gt;# user&amp;#39;s profile path. The file may not exist; run the commands below to create it and open it.&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;if&lt;/span&gt; &lt;span class="p"&gt;(!(&lt;/span&gt;&lt;span class="nb"&gt;Test-Path&lt;/span&gt; &lt;span class="n"&gt;-Path&lt;/span&gt; &lt;span class="nv"&gt;$PROFILE&lt;/span&gt; &lt;span class="p"&gt;))&lt;/span&gt; &lt;span class="p"&gt;{&lt;/span&gt; &lt;span class="nb"&gt;New-Item&lt;/span&gt; &lt;span class="n"&gt;-Type&lt;/span&gt; &lt;span class="n"&gt;File&lt;/span&gt; &lt;span class="n"&gt;-Path&lt;/span&gt; &lt;span class="nv"&gt;$PROFILE&lt;/span&gt; &lt;span class="n"&gt;-Force&lt;/span&gt; &lt;span class="p"&gt;}&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="n"&gt;notepad&lt;/span&gt; &lt;span class="nv"&gt;$PROFILE&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"# This downloads and installs the posh-git and oh-my-posh modules from PowerShell Gallery.\n# The former shows Git info in the prompt, and the latter provides the themes.\nInstall-Module posh-git -Scope CurrentUser\nInstall-Module oh-my-posh -Scope CurrentUser\n\n\n# Next, edit the PowerShell profile loaded at startup. In PowerShell, $PROFILE shows the current\n# user's profile path. The file may not exist; run the commands below to create it and open it.\nif (!(Test-Path -Path $PROFILE )) { New-Item -Type File -Path $PROFILE -Force }\nnotepad $PROFILE\n","title":"powershell"}&lt;/script&gt;&lt;/div&gt;&lt;p&gt;Add the following commands to the profile file:&lt;/p&gt;</description></item></channel></rss>