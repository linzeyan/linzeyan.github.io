&lt;h4 id="install-1"&gt;Install&lt;/h4&gt;
&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-6e7a1d58d2cdf0a4aa7df131cb68c18c-7"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;brew install ffmpeg
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;uv pip install mlx mlx-audio
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"brew install ffmpeg\nuv pip install mlx mlx-audio\n","title":"shell"}&lt;/script&gt;&lt;/div&gt;&lt;h4 id="convert-1"&gt;Convert&lt;/h4&gt;
&lt;h5 id="model"&gt;model&lt;/h5&gt;
&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-6e7a1d58d2cdf0a4aa7df131cb68c18c-8"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;python -m mlx_audio.convert &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; --hf-path models/MediaTek-Research/Breeze-ASR-25 &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; --mlx-path models/MediaTek-Research/Breeze-ASR-25-mlx &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; --dtype bfloat16 &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; --model-domain stt
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"python -m mlx_audio.convert \\\n\t--hf-path models/MediaTek-Research/Breeze-ASR-25 \\\n\t--mlx-path models/MediaTek-Research/Breeze-ASR-25-mlx \\\n\t--dtype bfloat16 \\\n\t--model-domain stt\n","title":"shell"}&lt;/script&gt;&lt;/div&gt;&lt;h5 id="audio-1"&gt;audio&lt;/h5&gt;
&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-6e7a1d58d2cdf0a4aa7df131cb68c18c-9"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;ffmpeg &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; -i ~/Downloads/talk.m4a &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; -ar &lt;span class="m"&gt;16000&lt;/span&gt; &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; -ac &lt;span class="m"&gt;1&lt;/span&gt; &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; -c:a pcm_s16le &lt;span class="se"&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; ~/Downloads/talk.wav
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"ffmpeg \\\n\t-i ~/Downloads/talk.m4a \\\n\t-ar 16000 \\\n\t-ac 1 \\\n\t-c:a pcm_s16le \\\n\t~/Downloads/talk.wav\n","title":"shell"}&lt;/script&gt;&lt;/div&gt;&lt;h4 id="run-1"&gt;Run&lt;/h4&gt;
