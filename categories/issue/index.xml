&lt;/ul&gt;
&lt;h4 id="python-ldap"&gt;python-ldap&lt;/h4&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;a href="https://www.python-ldap.org/en/latest/installing.html" target="_blank" rel="noopener"&gt;https://www.python-ldap.org/en/latest/installing.html&lt;/a&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-d724ade66995b91af53019fa3eee4380-0"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;$ pip install python-ldap
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;In file included from Modules/LDAPObject.c:9:
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;Modules/errors.h:8: fatal error: lber.h: No such file or directory
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"$ pip install python-ldap\nIn file included from Modules/LDAPObject.c:9:\n\n\nModules/errors.h:8: fatal error: lber.h: No such file or directory\n","title":"shell"}&lt;/script&gt;&lt;/div&gt;&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;Debian/Ubuntu:
&lt;code&gt;sudo apt-get install libsasl2-dev python-dev libldap2-dev libssl-dev&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;RedHat/CentOS:&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;div class="code-block" data-code-block&gt;&lt;div class="code-block-full" id="code-block-d724ade66995b91af53019fa3eee4380-1"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;sudo yum install python-devel openldap-devel
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;sudo yum groupinstall &lt;span class="s2"&gt;&amp;#34;Development tools&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;
&lt;script type="application/json" class="code-block-data"&gt;{"copyButton":true,"expanded":false,"labels":{"code":"Code","copied":"Copied!","copy":"Copy","copyError":"Copy failed. Try again.","showAll":"Show all {count} lines","showLess":"Show fewer lines"},"language":"","preview":"","source":"sudo yum install python-devel openldap-devel\nsudo yum groupinstall \"Development tools\"\n","title":"shell"}&lt;/script&gt;&lt;/div&gt;&lt;h4 id="molecule"&gt;molecule&lt;/h4&gt;
