&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;stockCache&lt;/span&gt; &lt;span style="color:#c678dd"&gt;map&lt;/span&gt;[&lt;span style="color:#e5c07b"&gt;string&lt;/span&gt;]&lt;span style="color:#56b6c2"&gt;*&lt;/span&gt;&lt;span style="color:#e06c75"&gt;StockAnalysisResult&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;mu&lt;/span&gt; &lt;span style="color:#e06c75"&gt;sync&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;RWMutex&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;sf&lt;/span&gt; &lt;span style="color:#e06c75"&gt;singleflight&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;Group&lt;/span&gt;
