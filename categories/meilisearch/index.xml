&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;v&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;err&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;_&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;:=&lt;/span&gt; &lt;span style="color:#e06c75"&gt;s&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;sf&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;Do&lt;/span&gt;(&lt;span style="color:#e06c75"&gt;key&lt;/span&gt;, &lt;span style="color:#c678dd"&gt;func&lt;/span&gt;() (&lt;span style="color:#c678dd"&gt;interface&lt;/span&gt;{}, &lt;span style="color:#e5c07b"&gt;error&lt;/span&gt;) {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#7f848e"&gt;// 3. 執行昂貴的邏輯 (DB + Gemini API)&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;result&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;err&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;:=&lt;/span&gt; &lt;span style="color:#e06c75"&gt;s&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;doAnalyzeStock&lt;/span&gt;(&lt;span style="color:#e06c75"&gt;ctx&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;code&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;name&lt;/span&gt;)
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#c678dd"&gt;if&lt;/span&gt; &lt;span style="color:#e06c75"&gt;err&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;!=&lt;/span&gt; &lt;span style="color:#e5c07b"&gt;nil&lt;/span&gt; {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#c678dd"&gt;return&lt;/span&gt; &lt;span style="color:#e5c07b"&gt;nil&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;err&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; }
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#7f848e"&gt;// 4. 寫入快取 (務必在 singleflight 內部完成，防止下一波瞬間擊穿)&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;s&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;mu&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;Lock&lt;/span&gt;()
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;s&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;stockCache&lt;/span&gt;[&lt;span style="color:#e06c75"&gt;code&lt;/span&gt;] = &lt;span style="color:#e06c75"&gt;result&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#e06c75"&gt;s&lt;/span&gt;.&lt;span style="color:#e06c75"&gt;mu&lt;/span&gt;.&lt;span style="color:#61afef;font-weight:bold"&gt;Unlock&lt;/span&gt;()
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#c678dd"&gt;return&lt;/span&gt; &lt;span style="color:#e06c75"&gt;result&lt;/span&gt;, &lt;span style="color:#e5c07b"&gt;nil&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; })
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#c678dd"&gt;if&lt;/span&gt; &lt;span style="color:#e06c75"&gt;err&lt;/span&gt; &lt;span style="color:#56b6c2"&gt;!=&lt;/span&gt; &lt;span style="color:#e5c07b"&gt;nil&lt;/span&gt; {
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#c678dd"&gt;return&lt;/span&gt; &lt;span style="color:#e5c07b"&gt;nil&lt;/span&gt;, &lt;span style="color:#e06c75"&gt;err&lt;/span&gt;
